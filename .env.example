# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mcg_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly"
STRIPE_PRICE_ELITE_MONTHLY="price_elite_monthly"
STRIPE_PRICE_LIFETIME="price_lifetime"

# AWS S3 (Video Storage)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="mcg-videos"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-key"
EMAIL_FROM="noreply@mayocoachinggolf.com"

# Video Calls (Daily.co)
DAILY_API_KEY="your-daily-api-key"
