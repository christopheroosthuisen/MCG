// MCG Database Schema
// Comprehensive schema for membership, credits, and coaching monetization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  membership    Membership?
  creditBalance CreditBalance?
  creditTransactions CreditTransaction[]
  swingReviews  SwingReview[]        @relation("StudentReviews")
  lessonsAsStudent Lesson[]          @relation("StudentLessons")
  messages      Message[]            @relation("UserMessages")
  coachProfile  Coach?
  notifications Notification[]
  referralsMade Referral[]           @relation("ReferrerUser")
  referredBy    Referral?            @relation("ReferredUser")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// MEMBERSHIP TIERS
// ============================================

enum MembershipTier {
  FREE
  STARTER
  PRO
  ELITE
  LIFETIME
}

enum MembershipStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  PAUSED
  EXPIRED
}

model Membership {
  id                    String           @id @default(cuid())
  userId                String           @unique
  tier                  MembershipTier   @default(FREE)
  status                MembershipStatus @default(ACTIVE)

  // Stripe subscription info
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?          @unique
  stripePriceId         String?

  // Billing cycle
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean          @default(false)

  // Lifetime membership
  isLifetime            Boolean          @default(false)
  lifetimePurchaseDate  DateTime?

  // Monthly credits (from membership)
  monthlyCreditsAllotted Int             @default(0)
  monthlyCreditsUsed     Int             @default(0)
  creditsResetDate       DateTime?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingHistory        BillingRecord[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model BillingRecord {
  id              String     @id @default(cuid())
  membershipId    String
  amount          Int        // in cents
  currency        String     @default("usd")
  status          String     // succeeded, failed, pending
  stripeInvoiceId String?
  description     String?
  createdAt       DateTime   @default(now())

  membership      Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

// ============================================
// CREDITS SYSTEM
// ============================================

model CreditBalance {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Purchased credits (never expire)
  purchasedCredits      Int      @default(0)

  // Rollover credits (expire after 1 month)
  rolloverCredits       Int      @default(0)
  rolloverExpiresAt     DateTime?

  // Bonus credits (from promotions, referrals)
  bonusCredits          Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreditTransactionType {
  PURCHASE           // Bought credit pack
  MEMBERSHIP_GRANT   // Monthly membership credits
  ROLLOVER           // Credits rolled over from previous month
  ROLLOVER_EXPIRED   // Rollover credits expired
  BONUS              // Promotional or referral bonus
  SPENT_REVIEW       // Used for swing review
  SPENT_LESSON       // Used for lesson
  REFUND             // Credited back for cancelled service
  ADMIN_ADJUSTMENT   // Manual adjustment by admin
}

model CreditTransaction {
  id              String                @id @default(cuid())
  userId          String
  type            CreditTransactionType
  amount          Int                   // positive = credit, negative = debit
  balanceAfter    Int                   // total balance after transaction
  description     String?
  referenceId     String?               // ID of related entity (review, lesson, etc.)
  referenceType   String?               // Type of related entity
  createdAt       DateTime              @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceId])
}

model CreditPackage {
  id              String   @id @default(cuid())
  name            String
  credits         Int
  bonusCredits    Int      @default(0)
  priceInCents    Int
  stripePriceId   String   @unique
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// COACHING SYSTEM
// ============================================

enum CoachStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Coach {
  id                String       @id @default(cuid())
  userId            String       @unique
  status            CoachStatus  @default(PENDING_APPROVAL)

  // Profile
  displayName       String
  bio               String?      @db.Text
  profileImage      String?
  coverImage        String?

  // Credentials
  certifications    String[]
  specialties       String[]
  yearsExperience   Int          @default(0)

  // Availability
  timezone          String       @default("America/New_York")
  availabilityRules Json?        // Structured availability data

  // Pricing (coach can set custom prices within limits)
  reviewPriceCredits     Int     @default(3)
  priorityReviewCredits  Int     @default(5)
  detailedReviewCredits  Int     @default(7)
  lesson30MinCredits     Int     @default(15)
  lesson60MinCredits     Int     @default(25)

  // Performance
  totalReviews      Int          @default(0)
  totalLessons      Int          @default(0)
  averageRating     Float        @default(0)
  responseTimeHours Float        @default(48)

  // Revenue share (percentage coach keeps)
  revenueSharePercent Int        @default(70)

  // Joseph Mayo flag
  isJosephMayo      Boolean      @default(false)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  swingReviews      SwingReview[]
  lessons           Lesson[]
  availability      CoachAvailability[]
  earnings          CoachEarning[]

  @@index([status])
  @@index([averageRating])
}

model CoachAvailability {
  id          String   @id @default(cuid())
  coachId     String
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isAvailable Boolean  @default(true)

  coach       Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

model CoachEarning {
  id              String   @id @default(cuid())
  coachId         String
  amount          Int      // in cents
  creditsEarned   Int
  referenceId     String   // lesson or review ID
  referenceType   String   // 'lesson' or 'review'
  status          String   @default("pending") // pending, paid, cancelled
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  coach           Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([status])
}

// ============================================
// SWING REVIEWS
// ============================================

enum ReviewStatus {
  PENDING_PAYMENT
  SUBMITTED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum ReviewType {
  STANDARD      // 5-7 days
  PRIORITY      // 48 hours
  DETAILED      // In-depth analysis
  JOSEPH_MAYO   // From Joseph Mayo himself
}

model SwingReview {
  id              String       @id @default(cuid())

  // Participants
  studentId       String
  coachId         String?

  // Request details
  type            ReviewType   @default(STANDARD)
  status          ReviewStatus @default(SUBMITTED)
  creditsCost     Int

  // Video submission
  videoUrl        String
  videoThumbnail  String?
  videoDuration   Int?         // in seconds
  clubUsed        String?
  shotType        String?      // drive, iron, chip, putt, etc.
  additionalNotes String?      @db.Text

  // Review response
  reviewVideoUrl  String?
  reviewNotes     String?      @db.Text
  drillsRecommended String[]

  // Timing
  submittedAt     DateTime     @default(now())
  assignedAt      DateTime?
  dueAt           DateTime?
  completedAt     DateTime?

  // Feedback
  studentRating   Int?         // 1-5
  studentFeedback String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student         User         @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  coach           Coach?       @relation(fields: [coachId], references: [id])

  @@index([studentId])
  @@index([coachId])
  @@index([status])
}

// ============================================
// LESSONS (LIVE COACHING)
// ============================================

enum LessonStatus {
  PENDING_PAYMENT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LessonType {
  VIDEO_CALL_30
  VIDEO_CALL_60
}

model Lesson {
  id              String       @id @default(cuid())

  // Participants
  studentId       String
  coachId         String

  // Booking details
  type            LessonType
  status          LessonStatus @default(SCHEDULED)
  creditsCost     Int

  // Scheduling
  scheduledAt     DateTime
  duration        Int          // in minutes
  timezone        String

  // Video call
  roomUrl         String?      // Daily.co room URL
  roomName        String?
  recordingUrl    String?

  // Notes
  studentGoals    String?      @db.Text
  coachNotes      String?      @db.Text
  followUpNotes   String?      @db.Text

  // Feedback
  studentRating   Int?         // 1-5
  studentFeedback String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student         User         @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  coach           Coach        @relation(fields: [coachId], references: [id])

  @@index([studentId])
  @@index([coachId])
  @@index([status])
  @@index([scheduledAt])
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id              String    @id @default(cuid())
  participantIds  String[]
  lastMessageAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())

  messages        Message[]

  @@index([participantIds])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  content         String       @db.Text
  attachmentUrl   String?
  attachmentType  String?      // image, video, document
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  REVIEW_SUBMITTED
  REVIEW_COMPLETED
  LESSON_BOOKED
  LESSON_REMINDER
  LESSON_COMPLETED
  CREDITS_LOW
  CREDITS_RECEIVED
  MEMBERSHIP_RENEWAL
  MEMBERSHIP_EXPIRING
  NEW_MESSAGE
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?            // Additional structured data
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ============================================
// REFERRAL PROGRAM
// ============================================

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredUserId  String   @unique
  referralCode    String
  creditsAwarded  Int      @default(0)
  status          String   @default("pending") // pending, completed, expired
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
}
