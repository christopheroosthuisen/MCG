// MCG Database Schema
// Comprehensive schema for membership, credits, and coaching monetization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  membership    Membership?
  creditBalance CreditBalance?
  creditTransactions CreditTransaction[]
  swingReviews  SwingReview[]        @relation("StudentReviews")
  lessonsAsStudent Lesson[]          @relation("StudentLessons")
  messages      Message[]            @relation("UserMessages")
  coachProfile  Coach?
  notifications Notification[]
  referralsMade Referral[]           @relation("ReferrerUser")
  referredBy    Referral?            @relation("ReferredUser")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// MEMBERSHIP TIERS
// ============================================

enum MembershipTier {
  FREE
  STARTER
  PRO
  ELITE
  LIFETIME
}

enum MembershipStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  PAUSED
  EXPIRED
}

model Membership {
  id                    String           @id @default(cuid())
  userId                String           @unique
  tier                  MembershipTier   @default(FREE)
  status                MembershipStatus @default(ACTIVE)

  // Stripe subscription info
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?          @unique
  stripePriceId         String?

  // Billing cycle
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean          @default(false)

  // Lifetime membership
  isLifetime            Boolean          @default(false)
  lifetimePurchaseDate  DateTime?

  // Monthly credits (from membership)
  monthlyCreditsAllotted Int             @default(0)
  monthlyCreditsUsed     Int             @default(0)
  creditsResetDate       DateTime?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingHistory        BillingRecord[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model BillingRecord {
  id              String     @id @default(cuid())
  membershipId    String
  amount          Int        // in cents
  currency        String     @default("usd")
  status          String     // succeeded, failed, pending
  stripeInvoiceId String?
  description     String?
  createdAt       DateTime   @default(now())

  membership      Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

// ============================================
// CREDITS SYSTEM
// ============================================

model CreditBalance {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Purchased credits (never expire)
  purchasedCredits      Int      @default(0)

  // Rollover credits (expire after 1 month)
  rolloverCredits       Int      @default(0)
  rolloverExpiresAt     DateTime?

  // Bonus credits (from promotions, referrals)
  bonusCredits          Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreditTransactionType {
  PURCHASE           // Bought credit pack
  MEMBERSHIP_GRANT   // Monthly membership credits
  ROLLOVER           // Credits rolled over from previous month
  ROLLOVER_EXPIRED   // Rollover credits expired
  BONUS              // Promotional or referral bonus
  SPENT_REVIEW       // Used for swing review
  SPENT_LESSON       // Used for lesson
  REFUND             // Credited back for cancelled service
  ADMIN_ADJUSTMENT   // Manual adjustment by admin
}

model CreditTransaction {
  id              String                @id @default(cuid())
  userId          String
  type            CreditTransactionType
  amount          Int                   // positive = credit, negative = debit
  balanceAfter    Int                   // total balance after transaction
  description     String?
  referenceId     String?               // ID of related entity (review, lesson, etc.)
  referenceType   String?               // Type of related entity
  createdAt       DateTime              @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceId])
}

model CreditPackage {
  id              String   @id @default(cuid())
  name            String
  credits         Int
  bonusCredits    Int      @default(0)
  priceInCents    Int
  stripePriceId   String   @unique
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// COACHING SYSTEM
// ============================================

enum CoachStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Coach {
  id                String       @id @default(cuid())
  userId            String       @unique
  status            CoachStatus  @default(PENDING_APPROVAL)

  // Profile
  displayName       String
  bio               String?      @db.Text
  profileImage      String?
  coverImage        String?
  introVideoUrl     String?      // Coach intro video

  // Credentials
  certifications    String[]
  specialties       String[]
  yearsExperience   Int          @default(0)

  // Availability
  timezone          String       @default("America/New_York")
  availabilityRules Json?        // Structured availability data

  // Pricing (coach can set custom prices within limits)
  reviewPriceCredits     Int     @default(3)
  priorityReviewCredits  Int     @default(5)
  detailedReviewCredits  Int     @default(7)
  lesson30MinCredits     Int     @default(15)
  lesson60MinCredits     Int     @default(25)
  chatCreditsPerMessage  Int     @default(1)

  // Performance
  totalReviews      Int          @default(0)
  totalLessons      Int          @default(0)
  totalGroupLessons Int          @default(0)
  totalContentViews Int          @default(0)
  averageRating     Float        @default(0)
  responseTimeHours Float        @default(48)
  followerCount     Int          @default(0)

  // Revenue share (percentage coach keeps) - determined by CoachTier
  revenueSharePercent Int        @default(60)

  // Lifetime earnings tracking
  lifetimeEarnings    Int        @default(0) // in cents
  pendingEarnings     Int        @default(0) // in cents
  lastPayoutAt        DateTime?

  // Joseph Mayo flag
  isJosephMayo      Boolean      @default(false)
  isFeatured        Boolean      @default(false)
  featuredOrder     Int?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      CoachSubscription?
  swingReviews      SwingReview[]
  lessons           Lesson[]
  groupLessons      GroupLesson[]
  availability      CoachAvailability[]
  earnings          CoachEarning[]
  payouts           CoachPayout[]
  payoutMethod      CoachPayoutMethod?
  content           CommunityContent[]
  products          CoachProduct[]
  tips              CoachTip[]
  referrals         CoachReferral[] @relation("CoachReferrals")
  analytics         CoachAnalytics[]

  @@index([status])
  @@index([averageRating])
  @@index([isFeatured])
}

model CoachAvailability {
  id          String   @id @default(cuid())
  coachId     String
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isAvailable Boolean  @default(true)

  coach       Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

model CoachEarning {
  id              String   @id @default(cuid())
  coachId         String
  amount          Int      // in cents
  creditsEarned   Int
  referenceId     String   // lesson or review ID
  referenceType   String   // 'lesson' or 'review'
  status          String   @default("pending") // pending, paid, cancelled
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  coach           Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([status])
}

// ============================================
// SWING REVIEWS
// ============================================

enum ReviewStatus {
  PENDING_PAYMENT
  SUBMITTED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum ReviewType {
  STANDARD      // 5-7 days
  PRIORITY      // 48 hours
  DETAILED      // In-depth analysis
  JOSEPH_MAYO   // From Joseph Mayo himself
}

model SwingReview {
  id              String       @id @default(cuid())

  // Participants
  studentId       String
  coachId         String?

  // Request details
  type            ReviewType   @default(STANDARD)
  status          ReviewStatus @default(SUBMITTED)
  creditsCost     Int

  // Video submission
  videoUrl        String
  videoThumbnail  String?
  videoDuration   Int?         // in seconds
  clubUsed        String?
  shotType        String?      // drive, iron, chip, putt, etc.
  additionalNotes String?      @db.Text

  // Review response
  reviewVideoUrl  String?
  reviewNotes     String?      @db.Text
  drillsRecommended String[]

  // Timing
  submittedAt     DateTime     @default(now())
  assignedAt      DateTime?
  dueAt           DateTime?
  completedAt     DateTime?

  // Feedback
  studentRating   Int?         // 1-5
  studentFeedback String?

  // Community sharing consent
  allowPublicShare Boolean     @default(false)
  publicShareConsent DateTime? // When student consented

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student         User         @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  coach           Coach?       @relation(fields: [coachId], references: [id])
  communityContent CommunityContent?

  @@index([studentId])
  @@index([coachId])
  @@index([status])
}

// ============================================
// LESSONS (LIVE COACHING)
// ============================================

enum LessonStatus {
  PENDING_PAYMENT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LessonType {
  VIDEO_CALL_30
  VIDEO_CALL_60
}

model Lesson {
  id              String       @id @default(cuid())

  // Participants
  studentId       String
  coachId         String

  // Booking details
  type            LessonType
  status          LessonStatus @default(SCHEDULED)
  creditsCost     Int

  // Scheduling
  scheduledAt     DateTime
  duration        Int          // in minutes
  timezone        String

  // Video call
  roomUrl         String?      // Daily.co room URL
  roomName        String?
  recordingUrl    String?

  // Notes
  studentGoals    String?      @db.Text
  coachNotes      String?      @db.Text
  followUpNotes   String?      @db.Text

  // Feedback
  studentRating   Int?         // 1-5
  studentFeedback String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  student         User         @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  coach           Coach        @relation(fields: [coachId], references: [id])

  @@index([studentId])
  @@index([coachId])
  @@index([status])
  @@index([scheduledAt])
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id              String    @id @default(cuid())
  participantIds  String[]
  lastMessageAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())

  messages        Message[]

  @@index([participantIds])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  content         String       @db.Text
  attachmentUrl   String?
  attachmentType  String?      // image, video, document
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  REVIEW_SUBMITTED
  REVIEW_COMPLETED
  LESSON_BOOKED
  LESSON_REMINDER
  LESSON_COMPLETED
  CREDITS_LOW
  CREDITS_RECEIVED
  MEMBERSHIP_RENEWAL
  MEMBERSHIP_EXPIRING
  NEW_MESSAGE
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?            // Additional structured data
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ============================================
// REFERRAL PROGRAM
// ============================================

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredUserId  String   @unique
  referralCode    String
  creditsAwarded  Int      @default(0)
  status          String   @default("pending") // pending, completed, expired
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
}

// ============================================
// COACH TIERS & SUBSCRIPTIONS
// ============================================

enum CoachTier {
  STARTER       // Free tier - 60% revenue share
  PROFESSIONAL  // $29/mo - 70% revenue share
  ELITE         // $79/mo - 80% revenue share
  MASTER        // $199/mo - 85% revenue share + featured
}

model CoachSubscription {
  id                    String      @id @default(cuid())
  coachId               String      @unique
  tier                  CoachTier   @default(STARTER)
  status                String      @default("active") // active, cancelled, past_due

  // Stripe info
  stripeSubscriptionId  String?     @unique
  stripePriceId         String?

  // Billing
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean     @default(false)

  // Benefits tracking
  featuredUntil         DateTime?   // For featured coach slots
  prioritySupport       Boolean     @default(false)
  customBranding        Boolean     @default(false)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  coach                 Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

// ============================================
// COMMUNITY CONTENT (CAMEO-STYLE)
// ============================================

enum CommunityContentType {
  PUBLIC_REVIEW       // Shareable swing review
  TIP_VIDEO           // Quick coaching tip
  DRILL_VIDEO         // Instructional drill
  Q_AND_A             // Community Q&A response
  ANALYSIS            // Pro player swing analysis
}

enum ContentVisibility {
  PUBLIC              // Anyone can view
  MEMBERS_ONLY        // Requires membership
  TIER_RESTRICTED     // Specific membership tier
  PURCHASERS_ONLY     // Must purchase to view
}

model CommunityContent {
  id                String               @id @default(cuid())
  coachId           String
  type              CommunityContentType
  visibility        ContentVisibility    @default(PUBLIC)
  requiredTier      MembershipTier?      // If TIER_RESTRICTED

  // Content
  title             String
  description       String?              @db.Text
  videoUrl          String
  thumbnailUrl      String?
  duration          Int?                 // seconds

  // Original review (if PUBLIC_REVIEW)
  originalReviewId  String?              @unique
  studentConsent    Boolean              @default(false)

  // Pricing (if purchasable)
  priceCredits      Int?                 // One-time purchase price
  isPurchasable     Boolean              @default(false)

  // Engagement
  viewCount         Int                  @default(0)
  likeCount         Int                  @default(0)
  commentCount      Int                  @default(0)

  // Coach earnings
  totalEarnings     Int                  @default(0) // in cents

  // Metadata
  tags              String[]
  isFeartured       Boolean              @default(false)
  publishedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  coach             Coach                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  originalReview    SwingReview?         @relation(fields: [originalReviewId], references: [id])
  purchases         ContentPurchase[]
  comments          ContentComment[]
  likes             ContentLike[]
  tips              ContentTip[]

  @@index([coachId])
  @@index([type])
  @@index([visibility])
  @@index([publishedAt])
}

model ContentPurchase {
  id              String           @id @default(cuid())
  contentId       String
  userId          String
  creditsPaid     Int
  createdAt       DateTime         @default(now())

  content         CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([userId])
}

model ContentComment {
  id              String           @id @default(cuid())
  contentId       String
  userId          String
  parentId        String?          // For replies
  text            String           @db.Text
  isCoachReply    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  content         CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([parentId])
}

model ContentLike {
  id              String           @id @default(cuid())
  contentId       String
  userId          String
  createdAt       DateTime         @default(now())

  content         CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
}

// ============================================
// TIPPING SYSTEM
// ============================================

model ContentTip {
  id              String           @id @default(cuid())
  contentId       String
  tipperId        String
  coachId         String
  creditAmount    Int
  message         String?
  isAnonymous     Boolean          @default(false)
  createdAt       DateTime         @default(now())

  content         CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([coachId])
  @@index([tipperId])
}

model CoachTip {
  id              String   @id @default(cuid())
  coachId         String
  tipperId        String
  creditAmount    Int
  message         String?
  isAnonymous     Boolean  @default(false)
  context         String?  // e.g., "lesson", "review", "general"
  referenceId     String?  // lesson or review ID
  createdAt       DateTime @default(now())

  coach           Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([tipperId])
}

// ============================================
// CERTIFICATION PROGRAM
// ============================================

enum CertificationLevel {
  FOUNDATIONAL      // Basic MCG methodology
  INTERMEDIATE      // Advanced techniques
  ADVANCED          // Full curriculum
  MASTER            // Master instructor
  SPECIALIST        // Specialty certifications
}

model Certification {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  level           CertificationLevel
  description     String             @db.Text
  requirements    String[]           // List of requirements
  priceCredits    Int                // Cost to attempt
  passingScore    Int                @default(80) // Percentage
  validityMonths  Int?               // null = lifetime
  badgeImageUrl   String?
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  attempts        CertificationAttempt[]
  coachCerts      CoachCertification[]
}

model CertificationAttempt {
  id              String        @id @default(cuid())
  certificationId String
  coachId         String
  score           Int?          // Percentage score
  passed          Boolean       @default(false)
  submissionUrl   String?       // Video submission URL
  reviewNotes     String?       @db.Text
  reviewedBy      String?       // Admin/reviewer ID
  reviewedAt      DateTime?
  creditsPaid     Int
  createdAt       DateTime      @default(now())

  certification   Certification @relation(fields: [certificationId], references: [id])

  @@index([coachId])
  @@index([certificationId])
}

model CoachCertification {
  id              String        @id @default(cuid())
  coachId         String
  certificationId String
  earnedAt        DateTime      @default(now())
  expiresAt       DateTime?
  certificateUrl  String?       // PDF certificate
  isDisplayed     Boolean       @default(true) // Show on profile

  certification   Certification @relation(fields: [certificationId], references: [id])

  @@unique([coachId, certificationId])
  @@index([coachId])
}

// ============================================
// CONVERSATION CREDITS (CHAT MONETIZATION)
// ============================================

enum ChatSessionType {
  FREE_TIER         // Limited messages for Pro+ members
  CREDIT_BASED      // Pay per message/session
  UNLIMITED         // Included with Elite+
}

model ChatSession {
  id                String          @id @default(cuid())
  conversationId    String
  studentId         String
  coachId           String
  type              ChatSessionType @default(CREDIT_BASED)

  // Credit tracking
  creditsPerMessage Int             @default(1)
  totalCreditsSpent Int             @default(0)
  messageCount      Int             @default(0)

  // Time-based billing
  sessionStarted    DateTime        @default(now())
  sessionEnded      DateTime?
  lastActivity      DateTime        @default(now())

  // Free tier limits
  freeMessagesUsed  Int             @default(0)
  freeMessagesLimit Int             @default(5)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([conversationId])
  @@index([studentId])
  @@index([coachId])
}

// ============================================
// COACH REFERRAL PROGRAM
// ============================================

model CoachReferral {
  id                  String   @id @default(cuid())
  referrerCoachId     String
  referredCoachId     String?  @unique // If referring a new coach
  referredStudentId   String?  @unique // If referring a student
  referralCode        String
  referralType        String   // 'coach' or 'student'

  // Revenue sharing
  revenueSharePercent Int      @default(5) // % of referred's revenue
  revenueShareMonths  Int      @default(12) // Duration of rev share
  totalEarned         Int      @default(0) // Total earned from this referral

  status              String   @default("pending") // pending, active, expired
  activatedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())

  referrerCoach       Coach    @relation("CoachReferrals", fields: [referrerCoachId], references: [id], onDelete: Cascade)

  @@index([referrerCoachId])
  @@index([referralCode])
}

// ============================================
// CONTENT MARKETPLACE
// ============================================

enum ProductType {
  DRILL_PACK          // Collection of drills
  COURSE              // Multi-video course
  EBOOK               // Written guide
  PRACTICE_PLAN       // Structured practice plan
  TEMPLATE            // Lesson templates for other coaches
}

model CoachProduct {
  id                String      @id @default(cuid())
  coachId           String
  type              ProductType
  name              String
  slug              String
  description       String      @db.Text
  shortDescription  String?

  // Pricing
  priceCredits      Int
  originalPrice     Int?        // For showing discounts
  isOnSale          Boolean     @default(false)

  // Content
  coverImageUrl     String?
  previewVideoUrl   String?
  contentUrls       String[]    // Array of content URLs
  downloadable      Boolean     @default(false)

  // Stats
  purchaseCount     Int         @default(0)
  averageRating     Float       @default(0)
  reviewCount       Int         @default(0)
  totalRevenue      Int         @default(0) // in cents

  // Status
  isPublished       Boolean     @default(false)
  publishedAt       DateTime?
  isFeatured        Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  coach             Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  purchases         ProductPurchase[]
  reviews           ProductReview[]

  @@unique([coachId, slug])
  @@index([coachId])
  @@index([type])
  @@index([isPublished])
}

model ProductPurchase {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  creditsPaid     Int
  purchasedAt     DateTime     @default(now())

  product         CoachProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

model ProductReview {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  rating          Int          // 1-5
  title           String?
  content         String?      @db.Text
  isVerified      Boolean      @default(true) // Verified purchase
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product         CoachProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// ============================================
// GROUP LESSONS
// ============================================

model GroupLesson {
  id                String    @id @default(cuid())
  coachId           String
  title             String
  description       String?   @db.Text

  // Scheduling
  scheduledAt       DateTime
  duration          Int       // minutes
  timezone          String

  // Capacity
  maxParticipants   Int       @default(10)
  minParticipants   Int       @default(2)

  // Pricing
  priceCredits      Int
  earlyBirdCredits  Int?      // Discounted price
  earlyBirdUntil    DateTime?

  // Video call
  roomUrl           String?
  roomName          String?
  recordingUrl      String?
  isRecorded        Boolean   @default(true)

  // Status
  status            String    @default("scheduled") // scheduled, live, completed, cancelled

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  coach             Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  participants      GroupLessonParticipant[]

  @@index([coachId])
  @@index([scheduledAt])
  @@index([status])
}

model GroupLessonParticipant {
  id              String      @id @default(cuid())
  groupLessonId   String
  userId          String
  creditsPaid     Int
  joinedAt        DateTime    @default(now())
  attended        Boolean     @default(false)
  rating          Int?
  feedback        String?

  groupLesson     GroupLesson @relation(fields: [groupLessonId], references: [id], onDelete: Cascade)

  @@unique([groupLessonId, userId])
  @@index([userId])
}

// ============================================
// PAYOUT SYSTEM
// ============================================

enum PayoutStatus {
  PENDING           // Earnings accruing
  PROCESSING        // Payout initiated
  COMPLETED         // Successfully paid
  FAILED            // Payout failed
  ON_HOLD           // Manual review required
}

model CoachPayout {
  id                  String       @id @default(cuid())
  coachId             String
  amount              Int          // in cents
  currency            String       @default("usd")
  status              PayoutStatus @default(PENDING)

  // Breakdown
  reviewEarnings      Int          @default(0)
  lessonEarnings      Int          @default(0)
  groupLessonEarnings Int          @default(0)
  contentEarnings     Int          @default(0)
  productEarnings     Int          @default(0)
  tipEarnings         Int          @default(0)
  referralEarnings    Int          @default(0)
  chatEarnings        Int          @default(0)

  // Deductions
  platformFee         Int          @default(0)
  processingFee       Int          @default(0)
  adjustments         Int          @default(0)
  adjustmentNotes     String?

  // Stripe
  stripeTransferId    String?
  stripePayoutId      String?

  // Timing
  periodStart         DateTime
  periodEnd           DateTime
  processedAt         DateTime?
  paidAt              DateTime?
  failureReason       String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  coach               Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([status])
  @@index([periodEnd])
}

model CoachPayoutMethod {
  id                String   @id @default(cuid())
  coachId           String   @unique
  type              String   // 'stripe_connect', 'paypal', 'bank_transfer'
  isVerified        Boolean  @default(false)

  // Stripe Connect
  stripeAccountId   String?
  stripeAccountType String?  // 'express', 'standard'

  // PayPal
  paypalEmail       String?

  // Bank (for manual transfers)
  bankName          String?
  accountLastFour   String?
  routingLastFour   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  coach             Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

// ============================================
// ANALYTICS & INSIGHTS
// ============================================

model CoachAnalytics {
  id                    String   @id @default(cuid())
  coachId               String
  date                  DateTime @db.Date

  // Revenue
  dailyRevenue          Int      @default(0)
  reviewRevenue         Int      @default(0)
  lessonRevenue         Int      @default(0)
  contentRevenue        Int      @default(0)
  productRevenue        Int      @default(0)
  tipRevenue            Int      @default(0)

  // Activity
  reviewsCompleted      Int      @default(0)
  lessonsCompleted      Int      @default(0)
  messagesResponded     Int      @default(0)
  contentViews          Int      @default(0)

  // Engagement
  profileViews          Int      @default(0)
  newFollowers          Int      @default(0)
  averageRating         Float?

  createdAt             DateTime @default(now())

  coach                 Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, date])
  @@index([coachId])
  @@index([date])
}
